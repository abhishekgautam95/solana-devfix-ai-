{
  "name": "solana-devfix-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic Solana/Anchor security scanner and dashboard.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build -w @solana-devfix-ai/web",
    "build:api": "tsc -b",
    "build:web": "npm run build -w @solana-devfix-ai/web",
    "clean": "tsc -b --clean",
    "dev": "npm run dev:web",
    "dev:api": "npm run dev -w @solana-devfix-ai/api",
    "dev:web": "npm run dev -w @solana-devfix-ai/web",
    "start": "npm run start -w @solana-devfix-ai/api"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "typescript": "^5.4.5"
  }
}
